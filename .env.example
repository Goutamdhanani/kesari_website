# UPI Configuration (for direct payments and QR generation)
DEFAULT_UPI_ID=kesari.memory@okhdfcbank
DEFAULT_PAYEE_NAME=Kesari Memory Studio

# Guest Check-In Google Apps Script Webhook (from qr-checkin sheet)
