HOST=0.0.0.0

# MongoDB Atlas Connection String
# Paste your MongoDB Atlas URI here (Free Tier cluster):
# e.g.: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=kesari_studio

# Admin Security Password (for Operations / Admin Portal)
