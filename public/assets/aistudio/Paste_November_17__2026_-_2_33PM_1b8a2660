<p>.onboarding-skip-btn:hover {<br /> background: rgba(255, 255, 255, 0.22);<br />}</p>
<p>/* Hero Image Wrap */<br />.onboarding-hero-image-wrap {<br /> position: relative;<br /> width: 100%;<br /> height: 290px;<br /> border-radius: 28px;<br /> overflow: hidden;<br /> margin: 12px 0 16px 0;<br /> box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);<br />}</p>
