<p>/* Liquid stage light stays behind the content, with a black falloff below. */<br />.home-curved-dome-header, .explore-curved-dome-header {<br /> background: radial-gradient(ellipse at 12% 0%, rgb(143 58 255 / 22%), transparent 57%),<br /> radial-gradient(ellipse at 92% 14%, rgb(32 160 241 / 15%), transparent 48%), #09070F;<br /> border-radius: 0 0 32px 32px; border-bottom-color: rgb(178 139 247 / 24%);<br /> box-shadow: inset 0 -1px 0 rgb(110 78 183 / 12%), 0 10px 24px rgb(0 0 0 / 34%);<br />}<br />.aurora-fluid-viewport, .explore-aurora-viewport, .aurora-fluid-vignette, .aurora-fluid-glass-gloss { border-radius: inherit; }<br />.aurora-fluid-viewport, .explore-aurora-viewport {<br /> background: radial-gradient(ellipse at 20% 0%, rgb(132 44 241 / 38%), transparent 57%),<br /> radial-gradient(ellipse at 85% 24%, rgb(28 128 237 / 24%), transparent 50%), #09070F;<br />}<br />.aurora-fluid-canvas { filter: blur(10px) saturate(175%) hue-rotate(12deg); -webkit-filter: blur(10px) saturate(175%) hue-rotate(12deg); opacity: .72; }<br />.aurora-fluid-vignette {<br /> background: radial-gradient(ellipse at 10% 5%, rgb(234 54 198 / 18%), transparent 53%),<br /> radial-gradient(ellipse at 92% 4%, rgb(45 181 255 / 17%), transparent 48%),<br /> linear-gradient(180deg, transparent 8%, rgb(5 5 9 / 62%) 72%, #050509);<br />}<br />.aurora-fluid-glass-gloss {<br /> background: linear-gradient(125deg, rgb(218 202 255 / 9%), transparent 40%, rgb(76 181 255 / 3%) 73%, transparent);<br /> box-shadow: inset 0 -1px 0 rgb(163 119 230 / 18%); border-bottom-color: rgb(183 161 226 / 15%);<br />}<br />.dome-hero-spotlight {<br /> border-radius: 24px; background: linear-gradient(135deg, rgb(34 22 58 / 80%), rgb(8 8 15 / 92%) 72%); border-color: rgb(197 164 255 / 25%);<br /> box-shadow: inset 0 1px 0 rgb(237 222 255 / 16%), inset 0 -1px 0 rgb(94 67 154 / 16%), 0 8px 30px rgb(0 0 0 / 32%);<br /> transition: transform var(--transition-fast), opacity var(--transition-fast);<br />}<br />.dome-hero-spotlight:hover { background: linear-gradient(135deg, rgb(40 25 69 / 82%), rgb(8 8 15 / 92%) 72%); border-color: rgb(196 165 255 / 40%); }<br />.dome-act-title { color: var(--color-ink-primary); font-size: 24px; line-height: 1.25; font-weight: 550; letter-spacing: -.035em; text-shadow: none; }<br />.dome-subtext { min-width: 0; flex: 1; font-size: 12px; line-height: 1.5; color: #C6BED9; }<br />.dome-footer-row { gap: 8px; }<br />.dome-live-tag { color: #DDD0FF; font-size: 11px; font-weight: 550; letter-spacing: 0; text-transform: none; }<br />.dome-db-badge { color: #DCD4F5; background: rgb(16 12 28 / 78%); font-size: 10px; font-weight: 500; }<br />.dome-venue-name { font-size: 12px; font-weight: 550; }<br />.dome-live-beacon, .live-pulse-dot, .wave-bar, .poster-timing-pulse,<br />.explore-live-dot, .explore-timing-dot, .explore-venue-dot { background: #B79AFF; box-shadow: 0 0 9px rgb(155 95 255 / 45%); }<br />.dome-halo-ring { border-style: solid; border-color: rgb(167 131 247 / 48%); }<br />.dome-avatar-img { border-color: rgb(245 245 245 / 65%); }<br />.dome-glass-btn, .dome-venue-capsule, .explore-dome-venue-pill {<br /> background: linear-gradient(145deg, rgb(46 32 69 / 76%), rgb(15 14 25 / 92%)); border-color: rgb(190 163 236 / 26%);<br /> box-shadow: inset 0 1px 0 rgb(239 225 255 / 11%), 0 3px 12px rgb(0 0 0 / 24%);<br />}</p>
<p>/* Pearl is reserved for the primary action and compact selected controls. */<br />.dome-tune-btn, .book-lime-cta-btn, .explore-claim-btn, .wallet-full-btn,<br />.ticket-primary-qr-btn, .qr-done-btn, .empty-reset-pill, .explore-empty-reset,<br />.space-book-wa-btn, .gear-whatsapp-cta-btn, .organise-whatsapp-btn,<br />.pass-modal-footer .pass-subscribe-btn, .upi-primary-pay-button, .upi-confirm-paid-btn {<br /> min-height: 44px; border-radius: 16px;<br /> background: var(--surface-pearl);<br /> color: var(--surface-pearl-ink); border: 1px solid rgb(247 242 255 / 88%);<br /> box-shadow: inset 0 1px 4px rgb(255 255 255 / 65%), inset 0 -2px 7px rgb(84 58 140 / 14%), 0 3px 18px rgb(132 76 238 / 20%);<br /> font-weight: 550; transition: transform var(--transition-fast), opacity var(--transition-fast);<br />}<br />.dome-tune-btn { font-size: 12px; }<br />.dome-tune-btn:hover, .book-lime-cta-btn:hover, .explore-claim-btn:hover, .ticket-primary-qr-btn:hover {<br /> background: var(--surface-pearl);<br /> box-shadow: inset 0 1px 4px rgb(255 255 255 / 65%), inset 0 -2px 7px rgb(84 58 140 / 14%), 0 4px 22px rgb(132 76 238 / 27%);<br /> transform: translateY(-1px);<br />}<br />.section-label, .explore-section-title { color: var(--color-ink-primary); font-size: 18px; font-weight: 550; letter-spacing: -.025em; }<br />.mobile-explore-screen .section-label { color: var(--color-ink-primary) !important; font-size: 18px !important; font-weight: 550 !important; letter-spacing: -.025em !important; }<br />.section-meta, .section-meta-action { font-size: 12px; font-weight: 500; }<br />.section-meta, .explore-section-count { color: var(--color-ink-secondary); }<br />.section-meta-action, .home-admin-text-link, .search-cancel-btn, .results-for-query,<br />.result-price, .saved-price, .saved-cat, .pass-tag { color: var(--color-accent-readable); }<br />.vibe-chip-btn, .search-genre-pill, .trending-chip {<br /> min-height: 44px; background: linear-gradient(145deg, #191226, #0D0C16); border-color: #3A2D51; color: var(--color-ink-secondary);<br /> box-shadow: inset 0 1px 0 rgb(207 178 255 / 8%); transition: transform var(--transition-fast), opacity var(--transition-fast);<br />}<br />.vibe-chip-label { color: var(--color-ink-secondary); font-size: 12px; font-weight: 500; }<br />.vibe-chip-icon { color: var(--color-ink-secondary); }<br />.vibe-chip-btn.active, .search-genre-pill.active, .gear-cat-pill.active, .choice-chip.active {<br /> background: var(--surface-pearl); border-color: #EEE9F0; color: var(--surface-pearl-ink); box-shadow: inset 0 1px 5px rgb(255 255 255 / 25%);<br />}<br />.vibe-chip-btn.active .vibe-chip-label, .vibe-chip-btn.active .vibe-chip-icon { color: var(--surface-pearl-ink); font-weight: 550; }<br />.trending-chip:hover { background: #261B3C; border-color: #715099; }</p>
<p>/* Smooth poster edges replace decorative cuts; source event art stays intact. */<br />.poster-pass-card, .explore-poster-card {<br /> background: var(--color-canvas-card);<br /> border-radius: 26px; border-color: rgb(186 151 240 / 29%); box-shadow: inset 0 1px 0 rgb(227 210 255 / 10%), 0 8px 26px rgb(0 0 0 / 38%);<br /> transition: transform var(--transition-smooth), opacity var(--transition-smooth);<br />}<br />.poster-pass-card:hover, .explore-poster-card:hover { border-color: rgb(183 143 255 / 55%); box-shadow: 0 8px 28px rgb(0 0 0 / 40%), 0 0 20px rgb(116 56 203 / 12%); }<br />.poster-card-vignette { background: linear-gradient(180deg, rgb(5 5 9 / 15%), rgb(5 5 9 / 5%) 32%, rgb(5 5 9 / 60%) 68%, rgb(5 5 9 / 95%)); }<br />.explore-card-vignette { background: linear-gradient(180deg, rgb(5 5 9 / 20%), rgb(5 5 9 / 10%) 35%, rgb(5 5 9 / 85%) 75%, rgb(5 5 9 / 98%)); }<br />.poster-card-drawer {<br /> border-radius: 20px; background: linear-gradient(145deg, rgb(35 22 52 / 90%), rgb(10 9 17 / 94%)); border-color: rgb(192 158 243 / 25%);<br /> box-shadow: inset 0 1px 0 rgb(233 215 255 / 12%), 0 5px 18px rgb(0 0 0 / 32%);<br />}<br />.poster-event-title, .explore-card-title { font-size: 16px; font-weight: 550; letter-spacing: -.02em; }<br />.poster-artist-name, .explore-card-artist { color: #C1B5D5; font-size: 12px; }<br />.poster-timing-text, .explore-timing-text { font-size: 12px; font-weight: 500; letter-spacing: 0; text-transform: none; }<br />.poster-price-val { font-size: 19px; font-weight: 600; }<br />.poster-stage-badge, .explore-stage-badge { font-size: 11px; font-weight: 500; text-transform: none; letter-spacing: 0; }<br />.poster-stage-badge, .explore-stage-badge, .poster-arrow-circle, .explore-arrow-circle { color: #F0E8FF; background: rgb(18 12 31 / 88%); border-color: rgb(193 165 247 / 32%); }<br />.poster-tag-chip { border-radius: 999px; font-size: 11px; font-weight: 500; }<br />.explore-card-drawer { min-height: 176px; justify-content: flex-end; flex-shrink: 0; }<br />.explore-card-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }<br />.explore-card-artist { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }<br />.explore-price-val { font-size: 17px; font-weight: 600; }</p>
<p>/* Two existing studio panels retain their grid and photography. */<br />.bento-services-card {<br /> background: radial-gradient(ellipse at 100% 0%, rgb(88 40 151 / 20%), transparent 66%), #0D0B15; border-color: rgb(172 130 232 / 25%); border-radius: 22px;<br /> box-shadow: inset 0 1px 0 rgb(233 215 255 / 10%), 0 4px 20px rgb(0 0 0 / 30%);<br />}<br />.bento-organise-card { border-radius: 22px; border-color: rgb(163 130 238 / 29%); box-shadow: inset 0 1px 0 rgb(223 210 255 / 12%), 0 4px 20px rgb(0 0 0 / 34%); }<br />.services-photo-preview { border-radius: 14px; }<br />.services-photo-badge, .services-photo-hint { font-size: 9px; font-weight: 500; letter-spacing: 0; color: #F6F5FC; }<br />.services-card-eyebrow { color: var(--color-accent-readable); font-size: 11px; font-weight: 550; letter-spacing: 0; text-transform: none; }<br />.services-card-tag { color: #C9BEDB; background: #21162F; font-size: 10px; font-weight: 500; white-space: nowrap; }<br />.service-item-row { min-height: 44px; background: linear-gradient(125deg, #1D142C, #100E1B); border-color: rgb(161 126 218 / 19%); border-radius: 12px; transition: transform var(--transition-fast), opacity var(--transition-fast); }<br />.service-item-row:hover { background: linear-gradient(125deg, #29193E, #151022); }<br />.service-item-title { color: var(--color-ink-primary); font-size: 12px; font-weight: 550; line-height: 1.35; white-space: normal; }<br />.service-item-desc { color: #C1B5D5; font-size: 10px; line-height: 1.4; }<br />.service-item-arrow { color: #CAB3EF; }<br />.organise-pill-tag { color: #EFE1FF; border-color: rgb(238 238 238 / 26%); font-size: 9px; font-weight: 500; letter-spacing: 0; text-transform: none; }<br />.organise-live-badge { font-size: 9px; font-weight: 500; }<br />.organise-card-title { font-size: 16px; line-height: 1.25; font-weight: 550; }<br />.organise-card-sub { font-size: 11px; line-height: 1.45; color: #E9DDF7; }<br />.organise-plan-btn {<br /> min-height: 44px; font-size: 12px; font-weight: 550; border-radius: 14px; background: linear-gradient(125deg, rgb(81 48 126 / 88%), rgb(31 24 53 / 94%));<br /> border-color: rgb(194 159 244 / 40%); box-shadow: inset 0 1px 0 rgb(235 220 255 / 17%);<br /> transition: transform var(--transition-fast), opacity var(--transition-fast);<br />}<br />.organise-plan-btn:hover { background: linear-gradient(125deg, rgb(102 58 159 / 90%), rgb(42 29 72 / 94%)); }<br />.organise-plan-arrow { color: #E6D7FF; }<br />.schedule-row-item, .search-result-card, .saved-event-item {<br /> border-radius: 18px; background: var(--surface-glass); border-color: #39294F;<br /> box-shadow: inset 0 1px 0 rgb(217 192 255 / 9%); transition: transform var(--transition-fast), opacity var(--transition-fast);<br />}<br />/* The inherited schedule hover sets a white inline colour. Keep its transform feedback. */<br />.schedule-row-item { background: var(--surface-glass) !important; }<br />.schedule-item-title { color: var(--color-ink-primary); font-size: 14px; font-weight: 550; }<br />.schedule-stage-name, .schedule-item-artist { color: var(--color-ink-secondary); font-size: 12px; }<br />.schedule-stage-name { font-weight: 500; letter-spacing: 0; text-transform: none; }<br />.schedule-price-tag { color: var(--color-ink-primary); font-size: 14px; font-weight: 550; }<br />.schedule-time-badge { font-size: 10px; font-weight: 500; }<br />.schedule-quick-btn, .result-arrow-circle, .pass-qr-thumb { background: #2E1F45; color: #EAD9FF; box-shadow: none; }<br />.schedule-row-item:hover .schedule-quick-btn { background: #4B2E6E; }<br />.home-admin-text-link { min-height: 44px; display: inline-flex; align-items: center; font-size: 12px; opacity: 1; border-bottom: 0; }<br />.home-admin-text-link:hover { color: #EEE5F4; }<br />.pass-empty-state { color: var(--color-ink-secondary); font-size: 12px; }</p>
<p>/* Search, profile, schedule and detail share the same readable surface family. */<br />.profile-header-title, .ticket-header-title, .explore-dome-heading { color: var(--color-ink-primary); font-size: 20px; font-weight: 550; letter-spacing: -.02em; }<br />.profile-identity-card, .passes-preview-card, .settings-group-card, .trending-searches-box, .search-empty-state, .explore-empty-box {<br /> background: #0D0C16; border-color: #3A3050; box-shadow: inset 0 1px 0 rgb(243 243 243 / 5%);<br />}<br />.profile-identity-card { border-radius: 28px; }<br />.identity-name { color: var(--color-ink-primary); font-size: 22px; font-weight: 550; }<br />.identity-handle, .identity-pill-tag, .stat-label, .settings-desc, .saved-date, .pass-time { font-size: 12px; }<br />.identity-handle, .stat-label, .settings-desc, .saved-date, .pass-time, .pass-tap-label,<br />.trending-title, .search-results-meta, .empty-sub { color: var(--color-ink-secondary); }<br />.trending-title { text-transform: none; letter-spacing: 0; font-weight: 550; }<br />.stat-number { color: var(--color-ink-primary); font-size: 20px; font-weight: 550; }<br />.settings-title, .saved-title, .pass-title, .result-title, .results-count, .empty-title { color: var(--color-ink-primary); font-size: 15px; font-weight: 550; }<br />.profile-seg-btn, .search-genre-pill { font-size: 13px; font-weight: 500; }<br />.identity-avatar-ring { background: conic-gradient(from 20deg, #8D50EE, #E5D9FF, #65D7F5, #586AE0, #A251DF, #8D50EE); }<br />.identity-vip-badge { color: #EEE5F4; border-color: #0D0C16; }<br />.identity-pill-tag, .result-category-badge { background: var(--color-accent-soft); color: var(--color-accent-readable); }<br />.identity-stats-row { background: #09080F; border-color: #302442; }<br />.stat-divider, .settings-divider { background: #3A3050; }<br />.profile-segmented-row, .search-input-wrapper { background: #171323; border-color: #514068; box-shadow: inset 0 1px 2px rgb(0 0 0 / 16%); }<br />.profile-seg-btn { min-height: 44px; color: var(--color-ink-secondary); transition: transform var(--transition-fast), opacity var(--transition-fast); }<br />.profile-seg-btn.active { color: var(--surface-pearl-ink); background: var(--surface-pearl); box-shadow: inset 0 1px 5px rgb(255 255 255 / 25%); }<br />.search-input-wrapper { min-width: 0; transition: none; }<br />.search-text-input { min-width: 0; color: var(--color-ink-primary); font-size: 15px; }<br />.search-text-input::placeholder { color: var(--color-ink-tertiary); }<br />.search-input-wrapper:focus-within { border-color: #C7A8FF; box-shadow: 0 0 0 2px rgb(201 201 201 / 18%); }<br />.search-result-card:hover { border-color: #3A3050; box-shadow: inset 0 1px 0 rgb(243 243 243 / 5%); }<br />.result-meta-row { color: var(--color-ink-secondary); font-size: 12px; }<br />.explore-live-label { color: #DCD0E5; font-size: 10px; font-weight: 500; letter-spacing: 0; text-transform: none; }<br />.explore-date-tab { min-height: 44px; font-size: 12px; font-weight: 500; color: #C1B5D5; }<br />.explore-date-tab.active { color: #191627; font-weight: 550; }<br />.explore-date-tab-active-pill { background: var(--surface-pearl); box-shadow: inset 0 1px 5px rgb(255 255 255 / 25%); }<br />.detail-title { color: var(--color-ink-primary); font-size: 24px; font-weight: 550; line-height: 1.2; letter-spacing: -.025em; }<br />.detail-description { color: var(--color-ink-secondary); font-size: 14px; line-height: 1.65; }<br />.quick-meta-item, .detail-quantity-row, .tier-card { background: #0D0C16; border-color: #3A3050; }<br />.tier-card { transition: transform var(--transition-fast), opacity var(--transition-fast); }<br />.tier-card:hover { background: #0D0C16; border-color: #3A3050; }<br />.tier-card.active-tier { border-color: #B98EFF; background: #271539; box-shadow: inset 0 1px 0 rgb(229 229 229 / 8%); }<br />.meta-sub, .tier-desc, .artist-role, .total-label { color: var(--color-ink-secondary); font-size: 12px; }<br />.meta-bold { color: var(--color-ink-