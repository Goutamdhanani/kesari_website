<p><br />/* ── Reference-driven premium colour pass (layout untouched) ─────────────<br /> Inspired by the Pulsetto / music-app references: a single luminous<br /> gradient surface per focal card, one lime accent for active/selected<br /> state, and quiet blue-glass everything else. Colour and glow only &mdash;<br /> no sizing, spacing, or behaviour changes. */</p>
<p>/* Hero: the AMOUR card becomes one soft lilac-to-coral light field,<br /> like the reference "Discover weekly" panel, instead of flat dark glass. */<br />.mobile-home-root-container .dome-hero-inner-content {<br /> background: linear-gradient(150deg, #2C3E7A 0%, #463B82 38%, #7A4F8C 68%, #C96A86 100%) padding-box,<br /> linear-gradient(135deg, rgb(201 215 255 / 62%), rgb(255 112 134 / 34%) 60%, rgb(255 255 255 / 16%)) border-box;<br /> box-shadow: inset 0 1px 0 rgb(255 255 255 / 22%), 0 10px 34px rgb(0 0 0 / 42%), 0 0 26px rgb(122 79 140 / 22%);<br />}<br />.mobile-home-root-container .dome-hero-inner-content::before {<br /> background: radial-gradient(ellipse at 12% 8%, rgb(155 190 255 / 26%), transparent 46%),<br /> radial-gradient(ellipse at 92% 96%, rgb(255 112 134 / 22%), transparent 44%);<br />}<br />.mobile-home-root-container .dome-live-tag,<br />.mobile-home-root-container .dome-subtext { color: #EEF3FF; }<br />.mobile-home-root-container .dome-act-title { color: #FFFFFF; }<br />.mobile-home-root-container .dome-timing-info { color: #DCE4F7; }</p>
<p>/* Active vibe chip: flat lime pearl, exactly like the reference "All" pill. */<br />.mobile-home-root-container .vibe-chip-btn.active {<br /> background: var(--surface-pearl);<br /> border-color: rgb(232 255 167 / 82%);<br /> color: var(--surface-pearl-ink);<br /> box-shadow: 0 0 18px rgb(218 251 113 / 22%), inset 0 1px 0 rgb(255 255 255 / 70%);<br />}<br />.mobile-home-root-container .vibe-chip-btn:not(.active) {<br /> background: rgb(18 23 34 / 82%);<br /> border-color: rgb(155 190 255 / 16%);<br /> color: #C9D7FF;<br />}</p>
<p>/* Poster cards: each takes its own coloured rim + glow from the artwork's<br /> dominant hue, so the carousel reads as a spectrum, not a grey grid. */<br />.mobile-home-root-container .stage-passes-scroll .poster-pass-card:nth-child(1) { --poster-accent: 77, 126, 255; }<br />.mobile-home-root-container .stage-passes-scroll .poster-pass-card:nth-child(2) { --poster-accent: 218, 251, 113; }<br />.mobile-home-root-container .stage-passes-scroll .poster-pass-card:nth-child(3) { --poster-accent: 255, 112, 134; }<br />.mobile-home-root-container .stage-passes-scroll .poster-pass-card:nth-child(4) { --poster-accent: 122, 79, 140; }<br />.mobile-home-root-container .stage-passes-scroll .poster-pass-card:nth-child(5) { --poster-accent: 0, 103, 232; }<br />.mobile-home-root-container .stage-passes-scroll .poster-pass-card {<br /> border-color: rgb(var(--poster-accent, 77 126 255) / 34%);<br /> box-shadow: 0 13px 30px rgb(0 0 0 / 43%), 0 0 20px rgb(var(--poster-accent, 77 126 255) / 16%), inset 0 1px 0 rgb(255 255 255 / 9%);<br />}<br />.mobile-home-root-container .poster-card-drawer {<br /> background: linear-gradient(150deg, rgb(var(--poster-accent, 77 126 255) / 18%), rgb(11 15 22 / 96%) 55%);<br /> border-color: rgb(var(--poster-accent, 77 126 255) / 26%);<br />}<br />.mobile-home-root-container .poster-stage-badge {<br /> color: #EBF1FF;<br /> background: rgb(var(--poster-accent, 77 126 255) / 26%);<br /> border-color: rgb(var(--poster-accent, 77 126 255) / 40%);<br />}<br />.mobile-home-root-container .poster-arrow-circle {<br /> background: rgb(var(--poster-accent, 77 126 255) / 30%);<br /> border-color: rgb(var(--poster-accent, 77 126 255) / 46%);<br /> box-shadow: 0 0 12px rgb(var(--poster-accent, 77 126 255) / 24%);<br />}</p>
<p>/* Bento services: cool cobalt wash on the photo card, matching the<br /> reference's blue-lit "Daily Goal" panel. */<br />.mobile-home-root-container .bento-services-card {<br /> background: radial-gradient(ellipse at 0% 0%, rgb(0 66 217 / 24%), transparent 55%),<br /> linear-gradient(160deg, #16203A, #0C111C 70%);<br /> border-color: rgb(93 148 255 / 30%);<br /> box-shadow: inset 0 1px 0 rgb(201 215 255 / 12%), 0 10px 30px rgb(0 0 0 / 40%), 0 0 22px rgb(0 66 217 / 12%);<br />}<br />.mobile-home-root-container .service-item-row {<br /> background: linear-gradient(120deg, rgb(25 34 54 / 92%), rgb(13 17 26 / 96%));<br /> border-color: rgb(155 190 255 / 14%);<br />}<br />.mobile-home-root-container .service-item-row:hover,<br />.mobile-home-root-container .service-item-row:focus-visible {<br /> background: linear-gradient(120deg, rgb(31 46 78 / 94%), rgb(15 21 34 / 97%));<br /> border-color: rgb(155 190 255 / 30%);<br />}</p>
<p>/* Organise card: warm coral edge glow that echoes the hero's right side. */<br />.mobile-home-root-container .bento-organise-card {<br /> border-color: rgb(255 112 134 / 30%);<br /> box-shadow: inset 0 1px 0 rgb(255 255 255 / 10%), 0 10px 30px rgb(0 0 0 / 44%), 0 0 22px rgb(255 112 134 / 12%);<br />}<br />.mobile-home-root-container .organise-plan-btn {<br /> background: linear-gradient(120deg, rgb(218 251 113 / 20%), rgb(0 66 217 / 34%));<br /> border-color: rgb(218 251 113 / 42%);<br /> color: #F5FFE0;<br />}<br />.mobile-home-root-container .organise-plan-btn:hover {<br /> background: linear-gradient(120deg, rgb(218 251 113 / 28%), rgb(0 66 217 / 44%));<br />}</p>
